<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="okno.MainWindow"
        Title="Drugie okno"
        Width="640"
        Height="420"
        WindowStartupLocation="CenterScreen">
  <Window.Background>#14213D</Window.Background>
    <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
        <TextBlock Text="Warsztat"
                             FontSize="42"
                             FontWeight="Bold"
                             Foreground="#FCA311"
                             HorizontalAlignment="Center" />
        <TextBlock Text="Małe zmiany, czytelny kod"
                             Foreground="White"
                             HorizontalAlignment="Center" />
            <Button Content="Kliknij, aby rozpocząć"
              HorizontalAlignment="Center" />
            <CheckBox Content="Tryb skupienia"
                  HorizontalAlignment="Center" />
            <TextBox Watermark="Wpisz swoje imię"
                 Width="240" />
                <Slider Minimum="0"
                  Maximum="100"
                  Width="240" />
                <ProgressBar Value="65"
                       Width="240" />
    </StackPanel>
</Window>
